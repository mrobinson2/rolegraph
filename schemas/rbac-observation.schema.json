{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ObservedAssignment": {
      "additionalProperties": false,
      "properties": {
        "principalId": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Principalid",
          "type": "string"
        },
        "roleDefinitionId": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Roledefinitionid",
          "type": "string"
        },
        "scope": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "maxLength": 32768,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "conditionVersion": {
          "anyOf": [
            {
              "const": "2.0",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conditionversion"
        },
        "delegatedManagedIdentityResourceId": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delegatedmanagedidentityresourceid"
        },
        "id": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "principalId",
        "roleDefinitionId",
        "scope",
        "id"
      ],
      "title": "ObservedAssignment",
      "type": "object"
    },
    "Permission": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "notActions": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "title": "Notactions",
          "type": "array"
        },
        "dataActions": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "title": "Dataactions",
          "type": "array"
        },
        "notDataActions": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "title": "Notdataactions",
          "type": "array"
        }
      },
      "required": [
        "actions",
        "notActions",
        "dataActions",
        "notDataActions"
      ],
      "title": "Permission",
      "type": "object"
    },
    "PinnedRole": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "permissions": {
          "items": {
            "$ref": "#/$defs/Permission"
          },
          "minItems": 1,
          "title": "Permissions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "permissions"
      ],
      "title": "PinnedRole",
      "type": "object"
    },
    "ScanScope": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "includeDescendants": {
          "default": true,
          "title": "Includedescendants",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "title": "ScanScope",
      "type": "object"
    },
    "ScopeResult": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "#/$defs/ScanScope"
        },
        "assignments": {
          "items": {
            "$ref": "#/$defs/ObservedAssignment"
          },
          "title": "Assignments",
          "type": "array"
        }
      },
      "required": [
        "scope",
        "assignments"
      ],
      "title": "ScopeResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "tenantId": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Tenantid",
      "type": "string"
    },
    "collectedAt": {
      "title": "Collectedat",
      "type": "string"
    },
    "scopeResults": {
      "items": {
        "$ref": "#/$defs/ScopeResult"
      },
      "title": "Scoperesults",
      "type": "array"
    },
    "roleDefinitions": {
      "items": {
        "$ref": "#/$defs/PinnedRole"
      },
      "title": "Roledefinitions",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "tenantId",
    "collectedAt",
    "scopeResults"
  ],
  "title": "Observation",
  "type": "object"
}
