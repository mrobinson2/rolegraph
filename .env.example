# RoleGraph configuration. Copy to .env and edit as needed.
# No secrets belong in this file or in source control.

# Any SQLAlchemy URL. PostgreSQL later is a connection-string change.
# ROLEGRAPH_DATABASE_URL=sqlite:///data/rolegraph.db

# Where the SQLite database is written.
# ROLEGRAPH_DATA_DIR=./data

# The synthetic demo tenant offered on the Import screen.
# ROLEGRAPH_DEMO_DATASET=data/demo/contoso.json

# Which roles the Privileged screen and the findings treat as privileged.
# ROLEGRAPH_PRIVILEGED_ROLES_FILE=config/privileged_roles.yaml

# Maximum accepted upload size in bytes (default 25 MB).
# ROLEGRAPH_MAX_UPLOAD_BYTES=26214400

# Host port used by docker compose.
# ROLEGRAPH_PORT=8000
